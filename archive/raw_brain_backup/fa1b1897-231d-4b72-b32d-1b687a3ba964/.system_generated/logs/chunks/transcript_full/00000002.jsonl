230000) {\n87:         tailText = tailText.substring(tailText.length - 230000);\n88:       }\n89: \n90:       const separator = '\\n\\nSystem: [Middle conversation omitted — focusing on session origin and recent context]\\n\\n';\n91:       fullText = headText + separator + tailText;\n92:     } else {\n93:       fullText = conversation.join('\\n\\n');\n94:     }\n95: \n96:     let truncationBoundaryType = 'none';\n97: \n98:     // Cap at 250000 chars (keep the most recent context)\n99:     if (fullText.length > 250000) {\n100:       const cut = fullText.substring(fullText.length - 250000);\n101:       let newText = cut;\n102:       \n103:       // Tier 1: Message Boundary\n104:       const msgMatch = cut.match(/\\n\\n(?:Human|AI|User):\\s/i);\n105:       if (msgMatch && msgMatch.index < 5000) {\n106:           newText = cut.substring(msgMatch.index + 2);\n107:           truncationBoundaryType = 'message_boundary';\n108:       } else {\n109:           // Tier 2: Paragraph Boundary\n110:           const paraMatch = cut.indexOf('\\n\\n');\n111:           if (paraMatch !== -1 && paraMatch < 5000) {\n112:               newText = cut.substring(paraMatch + 2);\n113:               truncationBoundaryType = 'paragraph_boundary';\n114:           } else {\n115:               // Tier 3: Sentence Boundary\n116:               const sentMatch = cut.match(/[.?!]\\s/);\n117:               if (sentMatch && sentMatch.index < 5000) {\n118:                   newText = cut.substring(sentMatch.index + 2);\n119:                   truncationBoundaryType = 'sentence_boundary';\n120:               } else {\n121:                   // Tier 4: Whitespace Boundary\n122:                   const spaceMatch = cut.indexOf(' ');\n123:                   if (spaceMatch !== -1 && spaceMatch < 5000) {\n124:                       newText = cut.substring(spaceMatch + 1);\n125:                       truncationBoundaryType = 'whitespace_boundary';\n126:                   } else {\n127:                       // 