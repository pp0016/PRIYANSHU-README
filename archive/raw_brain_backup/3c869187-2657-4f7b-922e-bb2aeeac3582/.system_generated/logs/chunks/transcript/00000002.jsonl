 if line and not line.startswith(\\\"CommandLine\\\") and \\\"mcp-remote\\\" in line.lower():\\n                # PID is the last number on the line\\n                parts = line.split()\\n                for part in reversed(parts):\\n                    if part.isdigit():\\n                        pids_to_kill.add(part)\\n                        print(f\\\"  Found m\n<truncated 1013 bytes>","Description":"\"Utility to kill stale mcp-remote processes that block NexLev OAuth on port 28085\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\renu5\\\\.gemini\\\\config\\\\skills\\\\nexlev-mcp-caller\\\\scripts\\\\nexlev_kill_stale.py\"","toolAction":"\"Creating nexlev_kill_stale.py\"","toolSummary":"\"Kill stale processes script\""}}],"truncated_fields":["tool_calls"]}
