{"step_index":99,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-25T12:57:38Z","content":"Got the client_id: `chatgpt-mcp-client`. Now let me build the full OAuth flow with a local callback server:","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"\nNexLev MCP OAuth Flow for Antigravity IDE\nOpens browser for NexLev login, captures OAuth callback, saves tokens.\n\"\"\"\nimport http.server\nimport webbrowser\nimport urllib.parse\nimport hashlib\nimport base64\nimport secrets\nimport json\nimport sys\nimport os\nimport threading\n\n# OAuth Configuration\nCLIENT_ID = \"chatgpt-mcp-client\"\nAUTH_URL = \"https://auth.nexlev.io/authorize\"\nTOKEN_URL = \"https://prod.dashboard.nexlev.io/api/mcp/oauth/token\"\nREDIRECT_URI = \"http://localhost:19876/callback\"\nSCOPE = \"openid profile email\"\n\n# Token save path\nTOKEN_FILE = os.path.join(os.path.dirname(__file__), \"nexlev_tokens.json\")\n\n# Generate PKCE challenge\ncode_verifier = secrets.token_urlsafe(64)[:128]\ncode_challenge = base64.urlsafe_b64encode(\n    hashlib.sha256(code_verifier.encode()).digest()\n).rstrip(b'=').decode()\n\n# State for CSRF protection\nstate = secrets.token_urlsafe(32)\n\nauth_code = None\nserver_shutdown = threading.Event()\n\n\nclass OAuthCallbackHandler(http.server.BaseHTTPRequestHandler):\n    def do_GET(self):\n        global auth_code\n        parsed = urllib.parse.urlparse(self.path)\n        params = urllib.parse.parse_qs(parsed.query)\n        \n        if parsed.path == \"/callback\":\n            if \"code\" in params:\n                auth_code = params[\"code\"][0]\n                received_state = params.get(\"state\", [None])[0]\n                \n                if received_state != state:\n                    self.send_response(400)\n                    self.send_header(\"Content-Type\", \"text/html\")\n                    self.end_headers()\n                    self.wfile.write(b\"<h1>Error: State mismatch</h1>\")\n                    return\n                \n                self.send_response(200)\n                self.send_header(\"Content-Type\", \"text/html\")\n                self.end_headers()\n                self.wfile.write(b\"\"\"\n                <html><body style=\"background:#1a1a2e;color:#fff;font-family:sans-serif;display:flex;justify-content:center;align-items:center;height:100vh;margin:0\">\n                <div style=\"text-align:center\">\n                <h1 style=\"color:#00ff88\">NexLev Connected Successfully!</h1>\n                <p>You can close this tab and go back to Antigravity.</p>\n                </div></body></html>\n                \"\"\")\n                server_shutdown.set()\n            elif \"error\" in params:\n                error = params[\"error\"][0]\n                self.send_response(400)\n                self.send_header(\"Content-Type\", \"text/html\")\n                self.end_headers()\n                self.wfile.write(f\"<h1>OAuth Error: {error}</h1>\".encode())\n                server_shutdown.set()\n        else:\n            self.send_response(404)\n            self.end_headers()\n    \n    def log_message(self, format, *args):\n        pass  # Suppress server logs\n\n\ndef exchange_code_for_tokens(code):\n    \"\"\"Exchange authorization code for access and refresh tokens\"\"\"\n    import urllib.request\n    \n    data = urllib.parse.urlencode({\n        \"grant_type\": \"authorization_code\",\n        \"code\": code,\n        \"redirect_uri\": REDIRECT_URI,\n        \"client_id\": CLIENT_ID,\n        \"code_verifier\": code_verifier,\n    }).encode()\n    \n    req = urllib.request.Request(TOKEN_URL, data=data, headers={\n        \"Content-Type\": \"application/x-www-form-urlencoded\"\n    })\n    \n    try:\n        with urllib.request.urlopen(req) as resp:\n            tokens = json.loads(resp.read().decode())\n            return tokens\n    except urllib.error.HTTPError as e:\n        error_body = e.read().decode()\n        print(f\"Token exchange failed: {e.code} - {error_body}\", file=sys.stderr)\n        return None\n\n\ndef main():\n    # Build authorization URL\n    auth_params = urllib.parse.urlencode({\n        \"response_type\": \"code\",\n        \"client_id\": CLIENT_ID,\n        \"redirect_uri\": REDIRECT_URI,\n        \"scope\": SCOPE,\n        \"state\": state,\n        \"code_challenge\": code_challenge,\n        \"code_challenge_method\": \"S256\",\n    })\n    \n    full_auth_url = f\"{AUTH_URL}?{auth_params}\"\n    \n    # Start local callback server\n    server = http.server.HTTPServer((\"localhost\", 19876), OAuthCallbackHandler)\n    server.timeout = 120  # 2 minute timeout\n    \n    print(\"Opening browser for NexLev login...\")\n    print(f\"\\nIf browser doesn't open, visit:\\n{full_auth_url}\\n\")\n    \n    # Open browser\n    webbrowser.open(full_auth_url)\n    \n    print(\"Waiting for authentication...\")\n    \n    # Wait for callback\n    while not server_shutdown.is_set():\n        server.handle_request()\n    \n    server.server_close()\n    \n    if auth_code:\n        print(\"Authorization received! Exchanging for tokens...\")\n        tokens = exchange_code_for_tokens(auth_code)\n        \n        if tokens:\n            # Save tokens\n            with open(TOKEN_FILE, \"w\") as f:\n                json.dump(tokens, f, indent=2)\n            \n            print(f\"\\nSUCCESS! Tokens saved to: {TOKEN_FILE}\")\n            print(f\"Access token: {tokens.get('access_token', 'N/A')[:20]}...\")\n            \n            # Also print the full access token for the bridge\n            print(f\"\\n__ACCESS_TOKEN__={tokens.get('access_token', '')}\")\n            if \"refresh_token\" in tokens:\n                print(f\"__REFRESH_TOKEN__={tokens.get('refresh_token', '')}\")\n            \n            return 0\n        else:\n            print(\"ERROR: Failed to exchange code for tokens\")\n            return 1\n    else:\n        print(\"ERROR: No authorization code received\")\n        return 1\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","Description":"Python script that performs OAuth 2.0 PKCE flow for NexLev MCP. Opens browser for login, captures the callback, exchanges for tokens, and saves them.","Overwrite":true,"TargetFile":"C:\\Users\\renu5\\.gemini\\antigravity\\scratch\\nexlev_oauth\\oauth_flow.py","toolAction":"Creating OAuth script","toolSummary":"OAuth flow script"}}]}
