{"step_index":239,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-08-25T18:10:35Z","content":"Created At: 2026-08-25T23:40:35+05:30\nCompleted At: 2026-08-25T23:40:35+05:30\nFile Path: `file:///C:/Users/renu5/.gemini/antigravity/scratch/vidiq_bridge/vidiq_mcp_bridge.py`\nTotal Lines: 324\nTotal Bytes: 14704\nShowing lines 1 to 324\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: vidIQ MCP Bridge v3 — Self-Healing, Correct Tool Names\n3: Reads API key from config file at runtime.\n4: Auto-recovers from bad sessions and expired keys without restart.\n5: Uses correct vidiq_* prefixed tool names matching the remote server.\n6: \"\"\"\n7: import os\n8: import sys\n9: import json\n10: import asyncio\n11: import aiohttp\n12: from pathlib import Path\n13: from mcp.server.stdio import stdio_server\n14: from mcp.server import Server\n15: from mcp.types import Tool, TextContent\n16: \n17: # --- Configuration ---\n18: VIDIQ_MCP_URL = \"https://mcp.vidiq.com/mcp\"\n19: \n20: # Config file locations (in priority order)\n21: CONFIG_PATHS = [\n22:     Path(os.path.expanduser(\"~\")) / \".gemini\" / \"config\" / \"mcp_config.json\",\n23:     Path(os.path.expanduser(\"~\")) / \".gemini\" / \"config\" / \"mcp.json\",\n24: ]\n25: \n26: local_server = Server(\"vidiq-mcp-bridge\")\n27: \n28: # --- Session State ---\n29: _remote_tools = None\n30: _http_session = None\n31: _request_counter = 0\n32: _current_api_key = None\n33: _initialized = False\n34: \n35: \n36: def _next_id():\n37:     global _request_counter\n38:     _request_counter += 1\n39:     return _request_counter\n40: \n41: \n42: def _read_api_key():\n43:     \"\"\"Read the API key fresh from config file every time. Falls back to env var.\"\"\"\n44:     for config_path in CONFIG_PATHS:\n45:         try:\n46:             if config_path.exists():\n47:                 with open(config_path, \"r\") as f:\n48:                     config = json.load(f)\n49:                 servers = config.get(\"mcpServers\", {})\n50:                 vidiq = servers.get(\"vidiq\", {})\n51:                 env = vidiq.get(\"env\", {})\n52:                 key = env.get(\"VIDIQ_API_KEY\", \"\")\n53:                 if key:\n54:                     return key\n55:         except Exception:\n56:             continue\n57:     return os.environ.get(\"VIDIQ_API_KEY\", \"\")\n58: \n59: \n60: def _get_headers():\n61:     \"\"\"Build headers with fresh API key.\"\"\"\n62:     api_key = _read_api_key()\n63:     headers = {\n64:         \"Content-Type\": \"application/json\",\n65:         \"Accept\": \"application/json, text/event-stream\",\n66:     }\n67:     if api_key:\n68:         headers[\"Authorization\"] = f\"Bearer {api_key}\"\n69:     return headers\n70: \n71: \n72: def _parse_sse_sync(text):\n73:     \"\"\"Parse SSE response text and return the JSON-RPC result.\"\"\"\n74:     for line in text.split(\"\\n\"):\n75:         line = line.strip()\n76:         if line.startswith(\"data:\"):\n77:             data_str = line[5:].strip()\n78:             if data_str:\n79:                 try:\n80:                     return json.loads(data_str)\n81:                 except json.JSONDecodeError:\n82:                     continue\n83:     return None\n84: \n85: \n86: async def _parse_response(response):\n87:     \"\"\"Parse response — handles both JSON and SSE formats.\"\"\"\n88:     content_type = response.headers.get(\"Content-Type\", \"\")\n89: \n90:     if \"text/event-stream\" in content_type:\n91:         text = await response.text()\n92:         return _parse_sse_sync(text)\n93:     else:\n94:         return await response.json()\n95: \n96: \n97: def _invalidate():\n98:     \"\"\"Reset all state.\"\"\"\n99:     global _remote_tools, _current_api_key, _initialized\n100:     _remote_tools = None\n101:     _current_api_key = None\n102:     _initialized = False\n103: \n104: \n105: async def _get_session():\n106:     \"\"\"Get or create HTTP session.\"\"\"\n107:     global _http_session\n108:     if _http_session is None or _http_session.closed:\n109:         _http_session = aiohttp.ClientSession()\n110:     return _http_session\n111: \n112: \n113: async def _init_and_discover():\n114:     \"\"\"Initialize connection and discover tools. Re-inits if key changed.\"\"\"\n115:     global _remote_tools, _current_api_key, _initialized\n116: \n117:     current_key = _read_api_key()\n118:     if not current_key:\n119:         raise Exception(\n120:             \"No API key. Set VIDIQ_API_KEY in ~/.gemini/config/mcp_config.json\"\n121:         )\n122: \n123:     # Skip if already initialized with same key\n124:     if _initialized and current_key == _current_api_key:\n125:         return\n126: \n127:     _invalidate()\n128:     _current_api_key = current_key\n129:     session = await _get_session()\n130:     headers = _get_headers()\n131: \n132:     # Step 1: Initialize\n133:     init_req = {\n134:         \"jsonrpc\": \"2.0\",\n135:         \"id\": _next_id(),\n136:         \"method\": \"initialize\",\n137:         \"params\": {\n138:             \"protocolVersion\": \"2025-03-26\",\n139:             \"capabilities\": {},\n140:             \"clientInfo\": {\"name\": \"vidiq-mcp-bridge\", \"version\": \"3.0.0\"}\n141:         }\n142:     }\n143: \n144:     try:\n145:         async with session.post(\n146:             VIDIQ_MCP_URL, headers=headers, json=init_req,\n147:             timeout=aiohttp.ClientTimeout(total=30)\n148:         ) as resp:\n149:             if resp.status == 401:\n150:                 _invalidate()\n151:                 raise Exception(\"API key rejected (401). Update VIDIQ_API_KEY in mcp_config.json\")\n152:             if resp.status != 200:\n153:                 _invalidate()\n154:                 text = await resp.text()\n155:                 raise Exception(f\"Init failed: HTTP {resp.status} - {text}\")\n156:             await _parse_response(resp)\n157:     except (aiohttp.ClientError, asyncio.TimeoutError) as e:\n158:         _invalidate()\n159:         raise Exception(f\"Connection failed: {e}\")\n160: \n161:     # Step 2: Initialized notification (best effort)\n162:     try:\n163:         async with session.post(\n164:             VIDIQ_MCP_URL, headers=headers,\n165:             json={\"jsonrpc\": \"2.0\", \"method\": \"notifications/initialized\", \"params\": {}},\n166:             timeout=aiohttp.ClientTimeout(total=10)\n167:         ) as resp:\n168:             pass\n169:     except Exception:\n170:         pass\n171: \n172:     # Step 3: Discover tools\n173:     try:\n174:         async with session.post(\n175:             VIDIQ_MCP_URL, headers=headers,\n176:             json={\"jsonrpc\": \"2.0\", \"id\": _next_id(), \"method\": \"tools/list\", \"params\": {}},\n177:             timeout=aiohttp.ClientTimeout(total=30)\n178:         ) as resp:\n179:             if resp.status == 200:\n180:                 result = await _parse_response(resp)\n181:                 if result and \"result\" in result:\n182:                     tools_data = result[\"result\"]\n183:                     if isinstance(tools_data, dict) and \"tools\" in tools_data:\n184:                         _remote_tools = tools_data[\"tools\"]\n185:     except Exception:\n186:         pass  # Fall back to hardcoded\n187: \n188:     _initialized = True\n189: \n190: \n191: # --- Hardcoded tool list (fallback — uses correct vidiq_* prefixed names) ---\n192: VIDIQ_TOOLS = [\n193:     Tool(name=\"vidiq_balance\", description=\"Check remaining vidIQ AI credit balance. FREE.\", inputSchema={\"type\": \"object\", \"properties\": {}, \"required\": []}),\n194:     Tool(name=\"vidiq_user_channels\", description=\"List YouTube/Instagram channels linked to vidIQ. FREE.\", inputSchema={\"type\": \"object\", \"properties\": {}, \"required\": []}),\n195:     Tool(name=\"vidiq_job_poll\", description=\"Check async job status. FREE.\", inputSchema={\"type\": \"object\", \"properties\": {\"job_id\": {\"type\": \"string\"}}, \"required\": [\"job_id\"]}),\n196:     Tool(name=\"vidiq_jobs_list\", description=\"List recent async jobs. FREE.\", inputSchema={\"type\": \"object\", \"properties\": {}, \"required\": []}),\n197:     Tool(name=\"vidiq_voiceover_list_voices\", description=\"List AI voice options. FREE.\", inputSchema={\"type\": \"object\", \"properties\": {}, \"required\": []}),\n198:     Tool(name=\"vidiq_trend_categories\", description=\"Browse trending categories. FREE.\", inputSchema={\"type\": \"object\", \"properties\": {}, \"required\": []}),\n199:     Tool(name=\"vidiq_submit_feedback\", description=\"Submit feedback to vidIQ. FREE.\", inputSchema={\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\"}}, \"required\": [\"message\"]}),\n200:     Tool(name=\"vidiq_keyword_research\", description=\"Keyword research. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"keyword\": {\"type\": \"string\"}}, \"required\": [\"keyword\"]}),\n201:     Tool(name=\"vidiq_outliers\", description=\"Find outlier videos. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"topic\": {\"type\": \"string\"}}, \"required\": [\"topic\"]}),\n202:     Tool(name=\"vidiq_trending_videos\", description=\"Trending videos. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"category\": {\"type\": \"string\"}, \"topic\": {\"type\": \"string\"}}, \"required\": []}),\n203:     Tool(name=\"vidiq_video_transcript\", description=\"Video transcript. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"video_url\": {\"type\": \"string\"}}, \"required\": [\"video_url\"]}),\n204:     Tool(name=\"vidiq_channel_analytics\", description=\"Channel analytics. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"channel_url\": {\"type\": \"string\"}}, \"required\": [\"channel_url\"]}),\n205:     Tool(name=\"vidiq_subscriber_insights\", description=\"Subscriber insights. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"channel_url\": {\"type\": \"string\"}}, \"required\": [\"channel_url\"]}),\n206:     Tool(name=\"vidiq_generate_titles\", description=\"Generate titles. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"topic\": {\"type\": \"string\"}}, \"required\": [\"topic\"]}),\n207:     Tool(name=\"vidiq_generate_thumbnail\", description=\"Generate thumbnail. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"title\": {\"type\": \"string\"}}, \"required\": [\"title\"]}),\n208:     Tool(name=\"vidiq_generate_clips\", description=\"Find clip timestamps. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"video_url\": {\"type\": \"string\"}}, \"required\": [\"video_url\"]}),\n209:     Tool(name=\"vidiq_video_watch\", description=\"Deep video analysis. 10 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"video_url\": {\"type\": \"string\"}}, \"required\": [\"video_url\"]}),\n210:     Tool(name=\"vidiq_watch_shortform_content\", description=\"Deep Reel/Short analysis. 10 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"reel_url\": {\"type\": \"string\"}}, \"required\": [\"reel_url\"]}),\n211:     Tool(name=\"vidiq_channel_stats\", description=\"Channel statistics. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"channel_url\": {\"type\": \"string\"}}, \"required\": [\"channel_url\"]}),\n212:     Tool(name=\"vidiq_video_stats\", description=\"Video statistics. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"video_url\": {\"type\": \"string\"}}, \"required\": [\"video_url\"]}),\n213:     Tool(name=\"vidiq_channel_search\", description=\"Search channels. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\"}}, \"required\": [\"query\"]}),\n214:     Tool(name=\"vidiq_youtube_search\", description=\"Search YouTube videos. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\"}}, \"required\": [\"query\"]}),\n215:     Tool(name=\"vidiq_similar_channels\", description=\"Find similar channels. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"channel_url\": {\"type\": \"string\"}}, \"required\": [\"channel_url\"]}),\n216:     Tool(name=\"vidiq_similar_videos\", description=\"Find similar videos. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"video_url\": {\"type\": \"string\"}}, \"required\": [\"video_url\"]}),\n217:     Tool(name=\"vidiq_score_title\", description=\"Score a video title. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"title\": {\"type\": \"string\"}}, \"required\": [\"title\"]}),\n218:     Tool(name=\"vidiq_score_thumbnail\", description=\"Score a thumbnail. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"image_url\": {\"type\": \"string\"}}, \"required\": [\"image_url\"]}),\n219:     Tool(name=\"vidiq_generate_script\", description=\"Generate video script. 5 credits.\", inputSchema={\"type\": \"object\", \"properties\": {\"topic\": {\"type\": \"string\"}}, \"required\": [\"topic\"]}),\n220: ]\n221: \n222: \n223: @local_server.list_tools()\n224: async def handle_list_tools() -> list[Tool]:\n225:     try:\n226:         await _init_and_discover()\n227:     except Exception:\n228:         pass\n229:     if _remote_tools:\n230:         return [\n231:             Tool(\n232:                 name=t.get(\"name\", \"unknown\"),\n233:                 description=t.get(\"description\", \"\"),\n234:                 inputSchema=t.get(\"inputSchema\", {\"type\": \"object\", \"properties\": {}, \"required\": []})\n235:             )\n236:             for t in _remote_tools\n237:         ]\n238:     return VIDIQ_TOOLS\n239: \n240: \n241: @local_server.call_tool()\n242: async def handle_call_tool(name: str, arguments: dict) -> list[TextContent]:\n243:     for attempt in range(2):\n244:         try:\n245:             await _init_and_discover()\n246:         except Exception as e:\n247:             return [TextContent(type=\"text\", text=f\"Error: {e}\")]\n248: \n249:         session = await _get_session()\n250:         headers = _get_headers()\n251: \n252:         call_request = {\n253:             \"jsonrpc\": \"2.0\",\n254:             \"id\": _next_id(),\n255:             \"method\": \"tools/call\",\n256:             \"params\": {\"name\": name, \"arguments\": arguments}\n257:         }\n258: \n259:         try:\n260:             async with session.post(\n261:                 VIDIQ_MCP_URL, headers=headers, json=call_request,\n262:                 timeout=aiohttp.ClientTimeout(total=60)\n263:             ) as response:\n264:                 if response.status == 401:\n265:                     _invalidate()\n266:                     if attempt == 0:\n267:                         continue\n268:                     return [TextContent(\n269:                         type=\"text\",\n270:                         text=\"Error: API key rejected (401). Update VIDIQ_API_KEY in mcp_config.json\"\n271:                     )]\n272: \n273:                 if response.status != 200:\n274:                     text = await response.text()\n275:                     if attempt == 0:\n276:                         _invalidate()\n277:                         continue\n278:                     return [TextContent(type=\"text\", text=f\"Error: HTTP {response.status} - {text}\")]\n279: \n280:                 result = await _parse_response(response)\n281: \n282:                 if result is None:\n283:                     return [TextContent(type=\"text\", text=\"Error: Empty response from vidIQ\")]\n284: \n285:                 if \"error\" in result:\n286:                     error = result[\"error\"]\n287:                     return [TextContent(type=\"text\", text=f\"vidIQ error: {error.get('message', str(error))}\")]\n288: \n289:                 if \"result\" in result:\n290:                     content = result[\"result\"]\n291:                     if isinstance(content, dict) and \"content\" in content:\n292:                         texts = []\n293:                         for item in content[\"content\"]:\n294:                             if isinstance(item, dict) and item.get(\"type\") == \"text\":\n295:                                 texts.append(item.get(\"text\", \"\"))\n296:                             else:\n297:                                 texts.append(json.dumps(item, indent=2))\n298:                         return [TextContent(type=\"text\", text=\"\\n\".join(texts))]\n299:                     else:\n300:                         return [TextContent(type=\"text\", text=json.dumps(content, indent=2))]\n301: \n302:                 return [TextContent(type=\"text\", text=json.dumps(result, indent=2))]\n303: \n304:         except asyncio.TimeoutError:\n305:             return [TextContent(type=\"text\", text=\"Error: Request timed out (60s). Try again.\")]\n306:         except aiohttp.ClientError as e:\n307:             _invalidate()\n308:             if attempt == 0:\n309:                 continue\n310:             return [TextContent(type=\"text\", text=f\"Error: Connection failed - {e}\")]\n311:         except Exception as e:\n312:             return [TextContent(type=\"text\", text=f\"Error: {type(e).__name__} - {e}\")]\n313: \n314:     return [TextContent(type=\"text\", text=\"Error: Failed after 2 attempts.\")]\n315: \n316: \n317: async def main():\n318:     async with stdio_server() as (read_stream, write_stream):\n319:         await local_server.run(read_stream, write_stream, local_server.create_initialization_options())\n320: \n321: \n322: if __name__ == \"__main__\":\n323:     asyncio.run(main())\n324: \nThe above content shows the entire, complete file contents of the requested file.\n"}
