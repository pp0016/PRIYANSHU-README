text\", text=f\"vidIQ error: {error.get('message', str(error))}\")]\n288: \n289:                 if \"result\" in result:\n290:                     content = result[\"result\"]\n291:                     if isinstance(content, dict) and \"content\" in content:\n292:                         texts = []\n293:                         for item in content[\"content\"]:\n294:                             if isinstance(item, dict) and item.get(\"type\") == \"text\":\n295:                                 texts.append(item.get(\"text\", \"\"))\n296:                             else:\n297:                                 texts.append(json.dumps(item, indent=2))\n298:                         return [TextContent(type=\"text\", text=\"\\n\".join(texts))]\n299:                     else:\n300:                         return [TextContent(type=\"text\", text=json.dumps(content, indent=2))]\n301: \n302:                 return [TextContent(type=\"text\", text=json.dumps(result, indent=2))]\n303: \n304:         except asyncio.TimeoutError:\n305:             return [TextContent(type=\"text\", text=\"Error: Request timed out (60s). Try again.\")]\n306:         except aiohttp.ClientError as e:\n307:             _invalidate()\n308:             if attempt == 0:\n309:                 continue\n310:             return [TextContent(type=\"text\", text=f\"Error: Connection failed - {e}\")]\n311:         except Exception as e:\n312:             return [TextContent(type=\"text\", text=f\"Error: {type(e).__name__} - {e}\")]\n313: \n314:     return [TextContent(type=\"text\", text=\"Error: Failed after 2 attempts.\")]\n315: \n316: \n317: async def main():\n318:     async with stdio_server() as (read_stream, write_stream):\n319:         await local_server.run(read_stream, write_stream, local_server.create_initialization_options())\n320: \n321: \n322: if __name__ == \"__main__\":\n323:     asyncio.run(main())\n324: \nThe above content shows the entire, complete file contents of the requested file.\n","t