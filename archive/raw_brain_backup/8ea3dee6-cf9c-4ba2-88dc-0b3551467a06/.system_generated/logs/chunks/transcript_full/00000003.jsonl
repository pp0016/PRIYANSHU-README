/www.apple.com/in/applecare/#brand\"\n2179: \t\t\t},\n2180: \t\t\t\"name\": \"AppleCare\",\n2181: \t\t\t\"description\": \"Enjoy peace of mind with easy priority support and fast repairs for accidental damage.\",\n2182: \t\t\t\"url\": \"https://www.apple.com/in/applecare/\",\n2183: \t\t\t\"mainEntityOfPage\": \"https://www.apple.com/in/applecare/\",\n2184: \t\t\t\"image\": \"https://www.apple.com/v/applecare/e/images/meta/ac__eh46qgda6qaa_og.png\",\n2185: \t\t\t\"potentialAction\": {\n2186: \t\t\t\t\"@type\": \"BuyAction\",\n2187: \t\t\t\t\"seller\": {\n2188: \t\t\t\t\t\"@id\": \"https://www.apple.com/#organization\"\n2189: \t\t\t\t},\n2190: \t\t\t\t\"url\": [\"https://coverage.apple.com/os/acacPP1/\"]\n2191: \t\t\t}\n2192: \t\t}\n2193: \t</script>\n2194: \t<script type=\"application/ld+json\">\n2195: \t\t{\n2196: \t\t\t\"@context\": \"https://schema.org\",\n2197: \t\t\t\"@type\": \"FAQPage\",\n2198: \t\t\t\"mainEntity\": [{\n2199: \t\t\t\t\t\"@type\": \"Question\",\n2200: \t\t\t\t\t\"name\": \"What is the difference between limited warranty and AppleCare+ coverage?\",\n2201: \t\t\t\t\t\"acceptedAnswer\": {\n2202: \t\t\t\t\t\t\"@type\": \"Answer\",\n2203: \t\t\t\t\t\t\"text\": \"Most Apple products come with 1 year of hardware coverage through the limited warranty. AppleCare plans extend that hardware coverage and provide additional features like accidental damage protection and priority support.\"\n2204: \t\t\t\t\t}\n2205: \t\t\t\t},\n2206: \t\t\t\t \n2207: \t\t\t\t{\n2208: \t\t\t\t\t\"@type\": \"Question\",\n2209: \t\t\t\t\t\"name\": \"How do I buy AppleCare?\",\n2210: \t\t\t\t\t\"acceptedAnswer\": {\n2211: \t\t\t\t\t\t\"@type\": \"Answer\",\n2212: \t\t\t\t\t\t\"text\": \"You can start an AppleCare+ plan when buying a new product with Apple in person. For 60 days, after a new Apple purchase, you can get a new plan through the settings app on your iPhone, iPad or Mac, or by calling 000800 1009009. Or within 60 days, you can go to an Apple Store to purchase a plan.\"\n2213: \t\t\t\t\t}\n2214: \t\t\t\t},\n2215: \t\t\t\t    \n2216: \t\t\t\t{\n2217: \t\t\t\t\t\"@type\": \"Question\",\n2218: \t\t\t\t\t\"name\": \"Does AppleCare cover accessories?\",\n2219: \t\t\t\t\t\"acceptedAnswer\": {\n2220: \t\t\t\t\t\t\"@type\": \"Answer\",\n2221: \t\t\t\t\t\t\"text\": \"When you protect your iPad with AppleCare+, you’ll get coverage for accidental damage for one Apple Pencil and one Apple‑branded iPad keyboard. AppleCare+ also covers any in-box cables and power adapters that came with your covered Apple product.\"\n2222: \t\t\t\t\t}\n2223: \t\t\t\t},\n2224: \t\t\t\t{\n2225: \t\t\t\t\t\"@type\": \"Question\",\n2226: \t\t\t\t\t\"name\": \"How can I get my device repaired?\",\n2227: \t\t\t\t\t\"acceptedAnswer\": {\n2228: \t\t\t\t\t\t\"@type\": \"Answer\",\n2229: \t\t\t\t\t\t\"text\": \"\n2230: You can get your device repaired a few different ways. You can mail it in using a prepaid shipping label from Apple. Or you can bring it in to an Apple Store or any of the over 5,000 Apple Authorised Service Providers. Start a repair by visiting <a href=https://support.apple.com/en-in/repair?cid=mc-ols-applecare-repair_homepage-marcom-07022025>support.apple.com/en-in/repair</a>, downloading the <a href=https://apps.apple.com/in/app/apple-support/id1130498044?pt=2003&ct=support.products&mt=8>Apple Support App</a> or calling your Apple Support phone number.\"\n2231: \t\t\t\t\t}\n2232: \t\t\t\t}\n2233: \t\t\t]\n2234: \t\t}\n2235: \t</script>\n2236: \t\n2237: \t\n2238: \n2239: \n2240: \n2241: <script src=\"/ac/pricing/latest-1/scripts/autopricing.built.js\" type=\"text/javascript\"></script>\n2242: \t<script src=\"/v/applecare/e/built/scripts/overview/main.built.js\" type=\"text/javascript\" charset=\"utf-8\"></script>\n2243: </body>\n2244: </html>\n2245: \n2246: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
