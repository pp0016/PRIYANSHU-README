{"step_index":39,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-17T02:32:41Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"\nImage Object Popup Animation → Video with Sound Effects\n========================================================\nTakes a cartoon image, detects distinct objects (blobs, character),\nanimates them popping up one-by-one with a bounce effect,\nand adds a \"pop\" sound for each one.\n\nWorks WITHOUT SAM/PyTorch — uses OpenCV contour detection\nwhich is perfect for cartoon/illustration images.\n\"\"\"\n\nimport os\nimport sys\nimport cv2\nimport numpy as np\nfrom PIL import Image, ImageFilter\nfrom pydub import AudioSegment\nfrom pydub.generators import Sine\nimport math\n\n# ============================================================\n# STEP 1: Generate synthetic pop SFX (since no SFX pack given)\n# ============================================================\ndef generate_pop_sound(output_path, freq_start=900, freq_end=350, duration_ms=80):\n    \"\"\"Creates a pleasant pitch-dropping 'pop' sound.\"\"\"\n    part1 = Sine(freq_start).to_audio_segment(duration=duration_ms // 2).fade_out(duration_ms // 3)\n    part2 = Sine(freq_end).to_audio_segment(duration=duration_ms // 2).fade_out(duration_ms // 3)\n    pop = part1 + part2\n    pop = pop - 5  # slightly quieter\n    pop.export(output_path, format=\"wav\")\n    return output_path\n\n\ndef generate_whoosh_sound(output_path, duration_ms=150):\n    \"\"\"Creates a quick whoosh/sweep sound.\"\"\"\n    sweep = AudioSegment.silent(duration=0)\n    steps = 15\n    for i in range(steps):\n        freq = 200 + (i * 80)  # rising sweep\n        chunk = Sine(freq).to_audio_segment(duration=duration_ms // steps)\n        chunk = chunk - (3 + i * 0.5)  # gradually quieter\n        sweep += chunk\n    sweep = sweep.fade_in(30).fade_out(60)\n    sweep.export(output_path, format=\"wav\")\n    return output_path\n\n\n# ============================================================\n# STEP 2: Segment objects from the cartoon image using OpenCV\n# ============================================================\ndef segment_cartoon_objects(image_path, min_area=3000, max_objects=10):\n    \"\"\"\n    Detects distinct objects in a cartoon image using color-based\n    segmentation + contour detection.\n    \n    Returns:\n        background (PIL.Image): The wooden plank background\n        objects (list): Each dict has 'image' (RGBA), 'bbox', 'centroid', 'area'\n    \"\"\"\n    # Load image\n    img_bgr = cv2.imread(image_path)\n    if img_bgr is None:\n        print(f\"ERROR: Cannot load {image_path}\")\n        sys.exit(1)\n    \n    img_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)\n    h, w = img_bgr.shape[:2]\n    \n    # Convert to HSV for better color segmentation\n    hsv = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2HSV)\n    \n    # The background is wooden planks (brownish/olive tones)\n    # We'll detect objects that are NOT the background\n    \n    # Strategy: Multiple color range masks for different blob colors\n    detected_masks = []\n    \n    # --- White/cream blobs ---\n    lower_white = np.array([15, 20, 180])\n    upper_white = np.array([35, 100, 255])\n    mask_white = cv2.inRange(hsv, lower_white, upper_white)\n    \n    # --- Orange/amber blobs ---\n    lower_orange = np.array([15, 100, 150])\n    upper_orange = np.array([30, 255, 255])\n    mask_orange = cv2.inRange(hsv, lower_orange, upper_orange)\n    \n    # --- Pink/salmon blobs ---\n    lower_pink = np.array([5, 40, 160])\n    upper_pink = np.array([18, 130, 230])\n    mask_pink = cv2.inRange(hsv, lower_pink, upper_pink)\n    \n    # --- The character (very light/white face + dark body) ---\n    # Character's face is very bright white\n    lower_face = np.array([0, 0, 210])\n    upper_face = np.array([180, 50, 255])\n    mask_face = cv2.inRange(hsv, lower_face, upper_face)\n    \n    # --- Dark elements (character body, rope, outlines) ---\n    lower_dark = np.array([0, 0, 0])\n    upper_dark = np.array([180, 255, 60])\n    mask_dark = cv2.inRange(hsv, lower_dark, upper_dark)\n    \n    # --- Red/maroon mouth + tendrils ---\n    lower_red = np.array([0, 80, 60])\n    upper_red = np.array([10, 255, 180])\n    mask_red = cv2.inRange(hsv, lower_red, upper_red)\n    lower_red2 = np.array([160, 80, 60])\n    upper_red2 = np.array([180, 255, 180])\n    mask_red2 = cv2.inRange(hsv, lower_red2, upper_red2)\n    mask_red_full = cv2.bitwise_or(mask_red, mask_red2)\n    \n    # Combine all non-background masks\n    combined_mask = cv2.bitwise_or(mask_white, mask_orange)\n    combined_mask = cv2.bitwise_or(combined_mask, mask_pink)\n    combined_mask = cv2.bitwise_or(combined_mask, mask_face)\n    combined_mask = cv2.bitwise_or(combined_mask, mask_dark)\n    combined_mask = cv2.bitwise_or(combined_mask, mask_red_full)\n    \n    # Clean up the mask\n    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))\n    combined_mask = cv2.morphologyEx(combined_mask, cv2.MORPH_CLOSE, kernel, iterations=3)\n    combined_mask = cv2.morphologyEx(combined_mask, cv2.MORPH_OPEN, kernel, iterations=1)\n    \n    # Find contours\n    contours, _ = cv2.findContours(combined_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    \n    # Filter by area and sort by size (largest first)\n    valid_contours = []\n    for cnt in contours:\n        area = cv2.contourArea(cnt)\n        if area >= min_area:\n            valid_contours.append((cnt, area))\n    \n    valid_contours.sort(key=lambda x: x[1], reverse=True)\n    valid_contours = valid_contours[:max_objects]\n    \n    print(f\"Found {len(valid_contours)} objects\")\n    \n    # Extract each object as an RGBA cutout\n    pil_img = Image.open(image_path).convert(\"RGBA\")\n    objects = []\n    \n    for i, (cnt, area) in enumerate(valid_contours):\n        # Create mask for this contour\n        obj_mask = np.zeros((h, w), dtype=np.uint8)\n        cv2.drawContours(obj_mask, [cnt], -1, 255, -1)\n        \n        # Dilate slightly to include edges\n        obj_mask = cv2.dilate(obj_mask, kernel, iterations=1)\n        \n        # Feather the edges (anti-aliasing)\n        obj_mask_float = cv2.GaussianBlur(obj_mask.astype(np.float32), (5, 5), 1.5)\n        obj_mask_feathered = np.clip(obj_mask_float, 0, 255).astype(np.uint8)\n        \n        # Get bounding box\n        x, y, bw, bh = cv2.boundingRect(cnt)\n        \n        # Add padding\n        pad = 10\n        x1 = max(0, x - pad)\n        y1 = max(0, y - pad)\n        x2 = min(w, x + bw + pad)\n        y2 = min(h, y + bh + pad)\n        \n        # Extract RGBA cutout\n        img_array = np.array(pil_img)\n        cutout = img_array[y1:y2, x1:x2].copy()\n        mask_crop = obj_mask_feathered[y1:y2, x1:x2]\n        cutout[:, :, 3] = mask_crop  # Set alpha channel\n        \n        cutout_pil = Image.fromarray(cutout, 'RGBA')\n        \n        # Calculate centroid\n        M = cv2.moments(cnt)\n        if M[\"m00\"] > 0:\n            cx = int(M[\"m10\"] / M[\"m00\"])\n            cy = int(M[\"m01\"] / M[\"m00\"])\n        else:\n            cx = x + bw // 2\n            cy = y + bh // 2\n        \n        objects.append({\n            'image': cutout_pil,\n            'bbox': (x1, y1, x2, y2),\n            'centroid': (cx, cy),\n            'area': area,\n            'position': (x1, y1),  # top-left for compositing\n            'index': i\n        })\n        \n        # Save cutout for debugging\n        cutout_path = os.path.join(os.path.dirname(image_path), f\"cutout_{i}.png\")\n        cutout_pil.save(cutout_path)\n        print(f\"  Object {i}: area={area:.0f}, center=({cx},{cy}), size={cutout_pil.size}\")\n    \n    # Create a simple background by inpainting (or just blurring the masked areas)\n    # Simple approach: fill masked areas with average background color\n    bg_img = img_rgb.copy()\n    \n    # Get background color from areas NOT covered by any object\n    all_masks = np.zeros((h, w), dtype=np.uint8)\n    for cnt, _ in valid_contours:\n        cv2.drawContours(all_masks, [cnt], -1, 255, -1)\n    all_masks = cv2.dilate(all_masks, kernel, iterations=2)\n    \n    # Use OpenCV inpainting to fill the holes\n    bg_inpainted = cv2.inpaint(img_bgr, all_masks, inpaintRadius=15, flags=cv2.INPAINT_TELEA)\n    bg_inpainted_rgb = cv2.cvtColor(bg_inpainted, cv2.COLOR_BGR2RGB)\n    background = Image.fromarray(bg_inpainted_rgb)\n    \n    # Save background\n    bg_path = os.path.join(os.path.dirname(image_path), \"clean_background.png\")\n    background.save(bg_path)\n    print(f\"  Background saved: {bg_path}\")\n    \n    return background, objects\n\n\n# ============================================================\n# STEP 3: Easing functions for the popup animation\n# ============================================================\ndef ease_out_back(t, s=1.70158):\n    \"\"\"Overshoots to ~115% then settles at 100% — classic cartoon pop.\"\"\"\n    t = max(0.0, min(1.0, t))\n    t -= 1.0\n    return t * t * ((s + 1) * t + s) + 1.0\n\n\ndef ease_out_bounce(t):\n    \"\"\"Bouncy landing effect.\"\"\"\n    t = max(0.0, min(1.0, t))\n    if t < 1 / 2.75:\n        return 7.5625 * t * t\n    elif t < 2 / 2.75:\n        t -= 1.5 / 2.75\n        return 7.5625 * t * t + 0.75\n    elif t < 2.5 / 2.75:\n        t -= 2.25 / 2.75\n        return 7.5625 * t * t + 0.9375\n    else:\n        t -= 2.625 / 2.75\n        return 7.5625 * t * t + 0.984375\n\n\n# ============================================================\n# STEP 4: Build the popup animation video with SFX\n# ============================================================\ndef build_popup_video(\n    image_path,\n    output_path=\"popup_animation.mp4\",\n    pop_duration=0.5,          # How long each popup animation lasts\n    interval=0.7,              # Time between each object appearing\n    initial_delay=0.3,         # Delay before first object\n    trailing_pause=2.0,        # Pause after last object\n    fps=30,\n    easing=\"back\"              # \"back\" or \"bounce\"\n):\n    \"\"\"Main pipeline: segment → animate → add sound → export video.\"\"\"\n    \n    print(\"=\" * 60)\n    print(\"  IMAGE POPUP VIDEO GENERATOR\")\n    print(\"=\" * 60)\n    \n    # --- Segment objects ---\n    print(\"\\n[1/4] Segmenting objects...\")\n    background, objects = segment_cartoon_objects(image_path)\n    \n    if not objects:\n        print(\"No objects found! Try adjusting min_area.\")\n        return\n    \n    w_bg, h_bg = background.size\n    num_objects = len(objects)\n    \n    # --- Sort objects: smaller objects first, character (largest) last ---\n    # This gives a nice reveal: blobs appear first, main character last\n    objects.sort(key=lambda o: o['area'])\n    \n    # --- Calculate timeline ---\n    total_duration = initial_delay + (num_objects * interval) + trailing_pause\n    \n    print(f\"\\n[2/4] Building animation timeline...\")\n    print(f\"  Objects: {num_objects}\")\n    print(f\"  Duration: {total_duration:.1f}s\")\n    print(f\"  Resolution: {w_bg}x{h_bg}\")\n    \n    # Choose easing function\n    ease_fn = ease_out_back if easing == \"back\" else ease_out_bounce\n    \n    # --- Generate sounds ---\n    print(\"\\n[3/4] Generating sound effects...\")\n    project_dir = os.path.dirname(image_path) or \".\"\n    pop_sfx_path = os.path.join(project_dir, \"sfx_pop.wav\")\n    whoosh_sfx_path = os.path.join(project_dir, \"sfx_whoosh.wav\")\n    generate_pop_sound(pop_sfx_path)\n    generate_whoosh_sound(whoosh_sfx_path)\n    \n    pop_sfx = AudioSegment.from_file(pop_sfx_path)\n    whoosh_sfx = AudioSegment.from_file(whoosh_sfx_path)\n    \n    # Master audio track\n    master_audio = AudioSegment.silent(duration=int(total_duration * 1000))\n    \n    # --- Render frames ---\n    print(\"\\n[4/4] Rendering frames...\")\n    total_frames = int(total_duration * fps)\n    frames = []\n    \n    bg_array = np.array(background.convert(\"RGB\"))\n    \n    for frame_idx in range(total_frames):\n        t = frame_idx / fps\n        \n        # Start with clean background\n        frame = Image.fromarray(bg_array.copy())\n        \n        # Draw each object that has appeared by time t\n        for obj_idx, obj in enumerate(objects):\n            appear_time = initial_delay + obj_idx * interval\n            \n            if t < appear_time:\n                continue  # This object hasn't appeared yet\n            \n            # Calculate animation progress\n            local_t = t - appear_time\n            progress = min(1.0, local_t / pop_duration)\n            scale = ease_fn(progress)\n            \n            if scale < 0.01:\n                continue\n            \n            # Get object image and scale it\n            obj_img = obj['image']\n            obj_w, obj_h = obj_img.size\n            \n            new_w = max(1, int(obj_w * scale))\n            new_h = max(1, int(obj_h * scale))\n            \n            scaled_img = obj_img.resize((new_w, new_h), Image.LANCZOS)\n            \n            # Position: centered on original position\n            pos_x = obj['position'][0] + (obj_w - new_w) // 2\n            pos_y = obj['position'][1] + (obj_h - new_h) // 2\n            \n            # Paste with alpha\n            frame.paste(scaled_img, (pos_x, pos_y), scaled_img)\n        \n        frames.append(np.array(frame))\n        \n        # Progress indicator\n        if frame_idx % (fps * 1) == 0:\n            print(f\"  Frame {frame_idx}/{total_frames} ({t:.1f}s)\")\n    \n    # --- Place SFX at each popup time ---\n    for obj_idx in range(num_objects):\n        appear_time = initial_delay + obj_idx * interval\n        appear_ms = int(appear_time * 1000)\n        \n        # Alternate between pop and whoosh sounds\n        sfx = pop_sfx if obj_idx % 2 == 0 else whoosh_sfx\n        master_audio = master_audio.overlay(sfx, position=appear_ms)\n    \n    # Export master audio\n    audio_path = os.path.join(project_dir, \"master_audio.wav\")\n    master_audio.export(audio_path, format=\"wav\")\n    \n    # --- Encode video with MoviePy ---\n    print(\"\\n  Encoding video...\")\n    from moviepy.editor import ImageSequenceClip, AudioFileClip\n    \n    video_clip = ImageSequenceClip(frames, fps=fps)\n    audio_clip = AudioFileClip(audio_path)\n    video_clip = video_clip.set_audio(audio_clip)\n    \n    video_clip.write_videofile(\n        output_path,\n        fps=fps,\n        codec=\"libx264\",\n        audio_codec=\"aac\",\n        logger=\"bar\"\n    )\n    \n    # Cleanup temp audio\n    if os.path.exists(audio_path):\n        os.remove(audio_path)\n    \n    print(f\"\\n{'=' * 60}\")\n    print(f\"  ✅ DONE! Video saved: {output_path}\")\n    print(f\"{'=' * 60}\")\n\n\n# ============================================================\n# RUN IT\n# ============================================================\nif __name__ == \"__main__\":\n    script_dir = os.path.dirname(os.path.abspath(__file__))\n    input_image = os.path.join(script_dir, \"input_image.jpg\")\n    output_video = os.path.join(script_dir, \"popup_animation.mp4\")\n    \n    build_popup_video(\n        image_path=input_image,\n        output_path=output_video,\n        pop_duration=0.5,     # Each popup takes 0.5 seconds\n        interval=0.7,         # 0.7 seconds between each popup\n        initial_delay=0.3,    # Wait 0.3s before first popup\n        trailing_pause=2.0,   # 2s pause showing all objects at the end\n        fps=30,\n        easing=\"back\"         # \"back\" = overshoot bounce, \"bounce\" = bouncy landing\n    )\n","Description":"Complete popup video pipeline: segments cartoon objects via OpenCV contour detection, creates bounce-in animation using MoviePy, generates synthetic pop SFX with Pydub, outputs final MP4.","Overwrite":true,"TargetFile":"C:\\Users\\renu5\\.gemini\\antigravity\\scratch\\popup-project\\popup_video.py","toolAction":"Writing popup video script","toolSummary":"Complete pipeline script"}}]}
