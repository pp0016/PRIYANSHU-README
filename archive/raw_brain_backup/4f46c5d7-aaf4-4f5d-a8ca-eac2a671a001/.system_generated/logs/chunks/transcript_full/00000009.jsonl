aw.line([cx+320, cy+25, cx+370-gl, cy+25], fill=\"#f39c12\", width=8)\n\n    elif scene_num == 5:\n        # Thumbs up, happy\n        draw.arc([cx-50, cy-20, cx+50, cy+50], 0, 180, fill=ink, width=12)\n        draw.arc([cx-40, cy-40, cx-10, cy-10], 180, 0, fill=ink, width=10)\n        draw.arc([cx+10, cy-40, cx+40, cy-10], 180, 0, fill=ink, width=10)\n        \n        draw.line([cx, cy+150, cx-180, cy+50], fill=ink, width=15) # Thumbs up arm\n        draw.ellipse([cx-220, cy+10, cx-160, cy+70], fill=ink) # Hand\n        draw.line([cx-190, cy+10, cx-190, cy-30], fill=ink, width=15) # Thumb\n        \n        draw.line([cx, cy+150, cx+120, cy+300], fill=ink, width=15)\n\ndef draw_frame(f_idx, total_frames):\n    img = Image.new(\"RGB\", (width, height), bg_color)\n    draw = ImageDraw.Draw(img)\n    \n    scene_duration = 270 # 1350 / 5\n    scene_num = min((f_idx // scene_duration) + 1, 5)\n    scene_frame = f_idx % scene_duration\n    prog = scene_frame / float(scene_duration)\n    \n    titles = [\n        \"STUDYING FOR HOURS?\",\n        \"THE 80/20 RULE\",\n        \"80% RESULTS = 20% EFFORT\",\n        \"FOCUS ON PYQs & CORE\",\n        \"WORK SMART, NOT HARD\"\n    ]\n    \n    # Center text horizontally\n    text = titles[scene_num-1]\n    bbox = font_large.getbbox(text)\n    tw = bbox[2] - bbox[0]\n    draw.text(((width - tw)/2, 250), text, fill=ink, font=font_large)\n    \n    # Progress bar at the bottom for YouTube shorts retention\n    draw.rectangle([0, height-20, width * (f_idx / float(total_frames)), height], fill=\"#e74c3c\")\n    \n    # Draw character (adjust Y depending on scene so it's vertically balanced)\n    draw_stickman(draw, 540, 1100, scene_num, prog)\n    \n    return img\n\ntotal = 1350\nstart_f = int(sys.argv[1])\nend_f = int(sys.argv[2])\n\nfor i in range(start_f, end_f + 1):\n    frame = draw_frame(i, total)\n    filename = f\"frame_{i:04d}.png\"\n    frame.save(os.path.join(output_dir, filename))\n    if i % 10 == 0:\n        print