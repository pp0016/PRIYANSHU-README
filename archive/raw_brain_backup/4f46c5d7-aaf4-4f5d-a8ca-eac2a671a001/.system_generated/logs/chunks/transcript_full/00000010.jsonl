mplementation details.\n\n\n**Refining the Stickman**\n\nI've realized the character paste replaces the lines, so I'm bobbing and rotating the entire full-body AI character for dynamism. I'm focusing on the bobbing effects to bring the character to life! It seems to fit the bill of animating the stickman.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import sys\nimport os\nimport math\nfrom PIL import Image, ImageDraw, ImageFont\n\noutput_dir = r\"C:\\Users\\renu5\\Downloads\\short_frames\"\nos.makedirs(output_dir, exist_ok=True)\n\nwidth, height = 1080, 1920\nbg_color = \"#FDFBF7\"\nink = \"#111111\"\n\n# Load the AI generated character\nimg_path = r\"C:\\Users\\renu5\\.gemini\\antigravity\\brain\\4f46c5d7-aaf4-4f5d-a8ca-eac2a671a001\\clean_stickman_sprite_1788250113680.jpg\"\nchar_img = Image.open(img_path).convert(\"RGBA\")\n\n# Extract the ink lines and make the white background transparent\ndatas = char_img.getdata()\nnew_data = []\nfor item in datas:\n    # If pixel is bright (white paper), make it fully transparent\n    if item[0] > 200 and item[1] > 200 and item[2] > 200:\n        new_data.append((255, 255, 255, 0))\n    else:\n        # Keep the ink lines\n        new_data.append(item)\nchar_img.putdata(new_data)\n\n# Resize character sprite to fit the scene\nchar_img = char_img.resize((700, 700))\n\ntry:\n    font_large = ImageFont.truetype(\"arialbd.ttf\", 75)\n    font_med = ImageFont.truetype(\"arial.ttf\", 60)\nexcept:\n    font_large = ImageFont.load_default()\n    font_med = ImageFont.load_default()\n\ndef draw_frame(f_idx, total_frames):\n    img = Image.new(\"RGB\", (width, height), bg_color)\n    draw = ImageDraw.Draw(img)\n    \n    scene_duration = 270 \n    scene_num = min((f_idx // scene_duration) + 1, 5)\n    scene_frame = f_idx % scene_duration\n    prog = scene_frame / float(scene_duration)\n    \n    titles = [\n        \"STUDYING FOR HOURS?\",\n        \"THE 80/20 RULE\",\n        \"80% RESULTS = 20% EFFORT\",\n        \"FOCUS ON PYQs & CORE\",\n        \"WORK SMART, NOT HARD\"\n    ]\n    \n    text = titles[scene_num-1]\n    bbox = font_large.getbbox(text)\n    tw = bbox[2] - bbox[0]\n    draw.text(((width - tw)/2, 250), text, fill=ink, font=font_large)\n    \n    # Progress bar\n    draw.rectangle([0, height-20, width * (f_idx / float(total_frames)), height], fill=\"#e74c3c\")\n    \n    cx, cy = 540, 1200\n    \n    # Animating the custom sprite!\n    # We'll add a subtle bobbing motion to simulate life/breathing\n    bob_y = math.sin(f_idx * 0.2) * 20\n    bob_rot = math.sin(f_idx * 0.1) * 3\n    \n    sprite = char_img.rotate(bob_rot, resample=Image.BICUBIC, expand=True)\n    sw, sh = sprite.size\n    \n    # Draw scene props behind the character\n    if scene_num == 1:\n        # Desk\n        desk_y = cy + 100\n        draw.rectangle([cx-400, desk_y, cx+400, desk_y+400], fill=\"#bdc3c7\", outline=ink, width=10)\n        # Stack of books piling up\n        num_books = int(1 + prog * 15)\n        for b in range(min(num_books, 10)): \n            bx = cx + 150\n            by = desk_y - 50 - b*50\n            draw.rectangle([bx, by, bx+250, by+50], fill=\"#e74c3c\", outline=ink, width=8)\n\n    elif scene_num == 2:\n        # Pie chart floating\n        pcx, pcy = 540, cy - 350\n        draw.pieslice([pcx-200, pcy-200, pcx+200, pcy+200], start=0, end=360, fill=\"#ecf0f1\", outline=ink, width=10)\n        offset_x = -20 * math.sin(prog * math.pi)\n        offset_y = -20 * math.sin(prog * math.pi)\n        draw.pieslice([pcx-200+offset_x, pcy-200+offset_y, pcx+200+offset_x, pcy+200+offset_y], start=180, end=252, fill=\"#e74c3c\", outline=ink, width=10)\n        draw.text((pcx+50, pcy-50), \"80%\", fill=ink, font=font_large)\n        draw.text((pcx-120+offset_x, pcy-120+offset_y), \"20%\", fill=bg_color, font=font_med)\n\n    elif scene_num == 3:\n        # Seesaw physics\n        sw_cx, sw_cy = 540, cy - 300\n        angle = 20 - prog * 40 \n        L = 350\n        lx = sw_cx - L * math.cos(math.radians(angle))\n        ly = sw_cy - L * math.sin(math.radians(angle))\n        rx = sw_cx + L * math.cos(math.radians(angle))\n        ry = sw_cy + L * math.sin(math.radians(angle))\n        draw.polygon([(sw_cx, sw_cy), (sw_cx-40, sw_cy+100), (sw_cx+40, sw_cy+100)], fill=ink)\n        draw.line([lx, ly, rx, ry], fill=ink, width=25)\n        drop_y = ly - 400 + (prog**3) * 400\n        draw.rectangle([lx-80, min(drop_y, ly-160), lx+80, min(drop_y+160, ly)], fill=\"#3498db\", outline=ink, width=10)\n        draw.text((lx-60, min(drop_y+50, ly-100)), \"20%\", fill=bg_color, font=font_med)\n        draw.rectangle([rx-150, ry-300, rx+150, ry], fill=\"#e74c3c\", outline=ink, width=10)\n        draw.text((rx-60, ry-180), \"80%\", fill=bg_color, font=font_large)\n\n    # Paste the custom AI character sprite!\n    img.paste(sprite, (int(cx - sw/2), int(cy - sh/2 + bob_y)), sprite)\n    \n    # Draw foreground props (in front of character)\n    if scene_num == 4:\n        # Throwing book flies away\n        book_x = cx - 250 - prog * 600\n        book_y = cy - 100 - prog * 200 + prog**2 * 800\n        draw.rectangle([book_x, book_y, book_x+120, book_y+160], fill=\"#95a5a6\", outline=ink, width=8)\n        # Holding glowing PYQ paper\n        draw.rectangle([cx+50, cy-100, cx+230, cy+150], fill=\"#f1c40f\", outline=ink, width=10)\n        draw.text((cx+70, cy-20), \"PYQs\", fill=ink, font=font_large)\n        gl = prog * 10\n        draw.line([cx+140, cy-120, cx+140, cy-170+gl], fill=\"#f39c12\", width=8)\n        draw.line([cx+250, cy+25, cx+300-gl, cy+25], fill=\"#f39c12\", width=8)\n\n    return img\n\ntotal = 1350\nstart_f = int(sys.argv[1])\nend_f = int(sys.argv[2])\n\nfor i in range(start_f, end_f + 1):\n    frame = draw_frame(i, total)\n    filename = f\"frame_{i:04d}.png\"\n    frame.save(os.path.join(output_dir, filename))\n","Description":"Writing script that extracts the AI generated image as a transparent sprite and uses it as the character in the video","Overwrite":false,"TargetFile":"C:\\Users\\renu5\\Downloads\\short_animation_ai.py","toolAction":"Writing a Python script to convert the generated AI character into a transparent sprite and insert it into the video","toolSummary":"Update Script with AI Sprite"}}]}
