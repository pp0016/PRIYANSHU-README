n58:       line(0, -35, sin(-armAngle)*25, -35 + cos(-armAngle)*25);\n59:       // Left arm (front)\n60:       line(0, -35, sin(armAngle)*25, -35 + cos(armAngle)*25);\n61:       \n62:       // Legs\n63:       let legAngle = sin(t) * PI / 3;\n64:       \n65:       // Right leg (back)\n66:       let backKneeX = sin(-legAngle)*25;\n67:       let backKneeY = 10 + cos(-legAngle)*25;\n68:       let backFootAngle = -legAngle + (sin(-legAngle) > 0 ? PI/6 : 0);\n69:       let backFootX = backKneeX + sin(backFootAngle)*25;\n70:       let backFootY = backKneeY + cos(backFootAngle)*25;\n71:       line(0, 10, backKneeX, backKneeY);\n72:       line(backKneeX, backKneeY, backFootX, backFootY);\n73: \n74:       // Left leg (front)\n75:       let frontKneeX = sin(legAngle)*25;\n76:       let frontKneeY = 10 + cos(legAngle)*25;\n77:       let frontFootAngle = legAngle + (sin(legAngle) > 0 ? PI/6 : 0);\n78:       let frontFootX = frontKneeX + sin(frontFootAngle)*25;\n79:       let frontFootY = frontKneeY + cos(frontFootAngle)*25;\n80:       line(0, 10, frontKneeX, frontKneeY);\n81:       line(frontKneeX, frontKneeY, frontFootX, frontFootY);\n82:       \n83:       pop();\n84:     }\n85:   </script>\n86: </body>\n87: </html>\n88: \nThe above content shows the entire, complete file contents of the requested file.\n"}
