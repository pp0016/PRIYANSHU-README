   \n    # Excited expression\n    # Wide eyes (large ovals)\n    eye_w = 15\n    eye_h = 25\n    draw.ellipse([center_x - 35 - eye_w, center_y - 210 - eye_h,\n                  center_x - 35 + eye_w, center_y - 210 + eye_h], fill=\"black\")\n    draw.ellipse([center_x + 35 - eye_w, center_y - 210 - eye_h,\n                  center_x + 35 + eye_w, center_y - 210 + eye_h], fill=\"black\")\n                  \n    # Big smile (Arc/Pie)\n    # Using a chord to make it look like an open mouth\n    draw.chord([center_x - 50, center_y - 170, center_x + 50, center_y - 110], start=0, end=180, fill=\"black\")\n    \n    # Body\n    body_start = (center_x, center_y - 180 + head_radius)\n    body_end = (center_x, center_y + 150)\n    draw.line([body_start, body_end], fill=\"black\", width=14)\n    \n    # Legs\n    left_leg_end = (center_x - 100, center_y + 350)\n    right_leg_end = (center_x + 100, center_y + 350)\n    draw.line([body_end, left_leg_end], fill=\"black\", width=14)\n    draw.line([body_end, right_leg_end], fill=\"black\", width=14)\n    \n    # Arms\n    # Raising both arms\n    shoulder = (center_x, center_y - 40)\n    \n    # Arm length\n    arm_length = 200\n    \n    # Smooth wave effect\n    wave = math.sin(progress * math.pi * 6) * 15 # +/- 15 degrees waving, 3 full waves\n    \n    # Left arm angle\n    start_angle_l = 135\n    end_angle_l = 225\n    # Ease out interpolation for raising arms\n    ease_progress = 1 - (1 - progress) ** 3\n    current_angle_l = start_angle_l + (end_angle_l - start_angle_l) * ease_progress + wave\n    \n    # Right arm angle\n    start_angle_r = 45\n    end_angle_r = -45\n    current_angle_r = start_angle_r + (end_angle_r - start_angle_r) * ease_progress - wave\n    \n    rad_l = math.radians(current_angle_l)\n    left_arm_end = (shoulder[0] + arm_length * math.cos(rad_l), shoulder[1] + arm_length * math.sin(rad_l))\n    \n    rad_r = math.radians(current_angle_r)\n    right_arm_end = (shoulder[0] + arm_length * math.cos(rad_r), shoulder[1] + arm_length * math.sin(rad_r))\n    \n    draw.line([shoulder, left_arm_end], fill=\"black\", width=14)\n    draw.line([shoulder, right_arm_end], fill=\"black\", width=14)\n\ntotal = 90\nfor i in range(181, 271):\n    img = Image.new(\"RGB\", (width, height), bg_color)\n    draw = ImageDraw.Draw(img)\n    draw_stickman(draw, i, total)\n    filename = f\"frame_{i}.png\"\n    img.save(os.path.join(output_dir, filename))\n\nprint(\"Frames 181-270 generated successfully!\")\n```\n</SYSTEM_MESSAGE>"}
