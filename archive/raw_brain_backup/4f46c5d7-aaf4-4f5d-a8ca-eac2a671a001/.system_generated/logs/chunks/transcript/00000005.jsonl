  strike_prog = (cycle - 5) / 10.0\n        hand_y = 600 - 150 * strike_prog\n        hand_x = 1200 + 50 * strike_prog\n    \n    # Stickman body\n    draw.ellipse([head_cx - head_r, head_cy - head_r, head_cx + head_r, head\n<truncated 519 bytes>\n head_cx - eye_offset_x + 10, head_cy + eye_offset_y - 10], fill='black', width=6)\n    draw.line([head_cx + eye_offset_x + 20, head_cy + eye_offset_y - 25, head_cx + eye_offset_x - 10, head_cy + eye_offset_y - 10], fill='black', width=6)\n    \n    # Strict mouth (upside down U or just straight)\n    draw.line([head_cx - 20, head_cy + 30, head_cx + 20, head_cy + 30], fill='black', width=6)\n    draw.line([head_cx - 20, head_cy + 30, head_cx - 30, head_cy + 40], fill='black', width=6)\n    draw.line([head_cx + 20, head_cy + 30, head_cx + 30, head_cy + 40], fill='black', width=6)\n    \n    # Body\n    shoulder_y = head_cy + head_r\n    pelvis_y = shoulder_y + 250\n    draw.line([head_cx, shoulder_y, head_cx, pelvis_y], fill='black', width=10)\n    \n    # Legs\n    draw.line([head_cx, pelvis_y, head_cx - 100, pelvis_y + 200], fill='black', width=10)\n    draw.line([head_cx, pelvis_y, head_cx + 100, pelvis_y + 200], fill='black', width=10)\n    \n    # Right Arm (Hand on hip)\n    draw.line([head_cx, shoulder_y + 20, head_cx + 80, shoulder_y + 100], fill='black', width=10)\n    draw.line([head_cx + 80, shoulder_y + 100, head_cx + 20, pelvis_y], fill='black', width=10)\n    \n    # Left Arm (Pointing aggressively with stick)\n    draw.line([head_cx, shoulder_y + 20, hand_x, hand_y], fill='black', width=10)\n    \n    # Stick\n    stick_length = 500\n    # stick direction: pointing towards blackboard (left and slightly up/down)\n    stick_end_x = hand_x - stick_length\n    stick_end_y = hand_y - (hand_y - 300) * 1.5 # magnify the motion\n    draw.line([hand_x, hand_y, stick_end_x, stick_end_y], fill='#8B4513', width=15) # brown stick\n    \n    return img\n\ndef main():\n    output_dir = r\"C:\\Users\\renu5\\Downloads\\stickman_master_asset\"\n    os.makedirs(output_dir, exist_ok=True)\n    \n    for i in range(361, 451):\n        img = draw_frame(i)\n        filename = f\"frame_{i}.png\"\n        filepath = os.path.join(output_dir, filename)\n        img.save(filepath)\n        print(f\"Saved {filepath}\")\n\nif __name__ == \"__main__\":\n    main()\n```\n</SYSTEM_MESSAGE>","truncated_fields":["content"]}
