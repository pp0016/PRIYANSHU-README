x - 20, head_y + 30), (head_x - 10, head_y + 20), \n               (head_x, head_y + 35), (head_x + 10, head_y + 20),\n               (head_x + 20, head_y + 30)], fill=\"black\", width=5)\n    \n    # Question marks floating\n    if frame_idx % 2\n<truncated 1856 bytes>\nd_radius + 20 + scratch_offset_x\n    hand_y = head_y - head_radius + 20 + scratch_offset_y\n    \n    # Elbow\n    elbow_x = shoulder_x - 130\n    elbow_y = shoulder_y - 30 + scratch_offset_y\n    \n    draw.line([(shoulder_x, shoulder_y), (elbow_x, elbow_y)], fill=\"black\", width=12)\n    draw.line([(elbow_x, elbow_y), (hand_x, hand_y)], fill=\"black\", width=12)\n\ndef draw_blackboard(draw):\n    # Blackboard frame\n    draw.rectangle([800, 150, 1800, 850], fill=\"#5C4033\", outline=\"black\", width=10)\n    # Blackboard surface\n    draw.rectangle([820, 170, 1780, 830], fill=\"#2E4A35\")\n    \n    # Confusing math on the blackboard\n    # 1 + 1 = 3\n    draw.line([950, 250, 950, 350], fill=\"white\", width=6)\n    \n    draw.line([1020, 300, 1080, 300], fill=\"white\", width=6)\n    draw.line([1050, 270, 1050, 330], fill=\"white\", width=6)\n    \n    draw.line([1150, 250, 1150, 350], fill=\"white\", width=6)\n    \n    draw.line([1220, 280, 1280, 280], fill=\"white\", width=6)\n    draw.line([1220, 320, 1280, 320], fill=\"white\", width=6)\n    \n    # Draw 3\n    draw.arc([1330, 250, 1390, 300], 270, 90, fill=\"white\", width=6)\n    draw.arc([1330, 300, 1390, 350], 270, 90, fill=\"white\", width=6)\n    \n    # Complex integral symbol\n    draw.arc([900, 500, 950, 600], 90, 270, fill=\"white\", width=6)\n    draw.line([925, 500, 925, 750], fill=\"white\", width=6)\n    draw.arc([900, 650, 950, 750], 270, 90, fill=\"white\", width=6)\n    \n    # random math squiggles\n    for i in range(15):\n        draw.line([1000 + i*30, 600 + math.sin(i)*60, 1030 + i*30, 600 + math.sin(i+1)*60], fill=\"white\", width=6)\n\nfor i in range(91, 181):\n    img = Image.new('RGB', (width, height), color='#00F