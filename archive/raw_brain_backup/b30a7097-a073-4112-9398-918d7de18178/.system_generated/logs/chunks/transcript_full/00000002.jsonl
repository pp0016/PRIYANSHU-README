ted\",\"private\"],\"type\":\"string\"},\"maxItems\":3,\"minItems\":1,\"type\":\"array\"},\"search\":{\"description\":\"Optional title-only search string, from 1 to 100 characters.\",\"maxLength\":100,\"minLength\":1,\"type\":\"string\"},\"videoType\":{\"description\":\"Video type filters. Omit when all long, short, and live videos are acceptable.\",\"items\":{\"enum\":[\"long\",\"short\",\"live\"],\"type\":\"string\"},\"maxItems\":3,\"minItems\":1,\"type\":\"array\"}},\"required\":[\"channelId\"],\"type\":\"object\"}}\nThe above content shows the entire, complete file contents of the requested file.\n"}
