rrays might not be valid JSON if they contain JS expressions like `null` without quotes etc.\n        # we can replace some common JS unquoted keys if necessary, but re.findall r'\\[\\s*\\[.*?\\]\\s*\\]' might catch valid JSON\n        # Actually, Google's JSON is usually valid JSON but might have missing elements `[1,,2]`\n        clean_s = re.sub(r',\\s*,', ',null,', s)\n        clean_s = re.sub(r'\\[\\s*,', '[null,', clean_s)\n        clean_s = re.sub(r',\\s*\\]', ',null]', clean_s)\n        data = json.loads(clean_s)\n        extracted.extend(extract_strings_from_any(data))\n    except Exception as e:\n        pass\n\n# If parsing fails, fallback to simple string literal extraction\nif not extracted:\n    strings = re.findall(r'\"([^\"\\\\]*(?:\\\\.[^\"\\\\]*)*)\"', html)\n    for s in strings:\n        # replace escaped chars\n        s = s.encode('utf-8').decode('unicode_escape') if '\\\\' in s else s\n        if len(s) > 20 and ' ' in s and not s.startswith('http') and '<html' not in s:\n            extracted.append(s)\n\nwith open('all_strings.txt', 'w', encoding='utf-8') as out:\n    for e in extracted:\n        out.write(e + '\\n\\n')\nprint(f\"Dumped {len(extracted)} strings.\")\n","Description":"Extract all strings from HTML","Overwrite":true,"TargetFile":"C:\\Users\\renu5\\.gemini\\antigravity\\scratch\\extract4.py","toolAction":"Writing aggressive text extractor","toolSummary":"Write generic text extractor"}}]}
