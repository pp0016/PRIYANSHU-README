      <!-- Plate -->\n          <path d=\"M 50 100 L 150 100 C 180 100 190 115 200 115 L 350 115\" fill=\"none\" stroke=\"#ef4444\" stroke-width=\"2\"/>\n          <path d=\"M 50 150 L 150 150 C 180 150 190 135 200 135 L 350 135\" fill=\"none\" stroke=\"#ef4444\" stroke-width=\"2\"/>\n          \n          <!-- Geometry lines -->\n          <!-- Radius to entry -->\n          <line x1=\"200\" y1=\"50\" x2=\"150\" y2=\"100\" stroke=\"#0f172a\" stroke-width=\"2\" stroke-dasharray=\"4,4\"/>\n          <text x=\"165\" y=\"75\" fill=\"#0f172a\" font-family=\"sans-serif\">R</text>\n          <!-- Vertical center line -->\n          <line x1=\"200\" y1=\"50\" x2=\"200\" y2=\"115\" stroke=\"#0f172a\" stroke-width=\"2\" stroke-dasharray=\"4,4\"/>\n          <!-- Horizontal l line -->\n          <line x1=\"150\" y1=\"100\" x2=\"200\" y2=\"100\" stroke=\"#0f172a\" stroke-width=\"2\"/>\n          <text x=\"175\" y=\"95\" fill=\"#0f172a\" font-family=\"sans-serif\">l</text>\n          \n          <!-- Angle alpha -->\n          <path d=\"M 185 65 A 30 30 0 0 0 195 80\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\"/>\n          <text x=\"180\" y=\"90\" fill=\"#000\" font-size=\"12\" font-family=\"sans-serif\">α</text>\n          \n          <!-- Thickness labels -->\n          <text x=\"60\" y=\"130\" fill=\"#ef4444\" font-family=\"sans-serif\">t0</text>\n          <text x=\"320\" y=\"130\" fill=\"#ef4444\" font-family=\"sans-serif\">tf</text>\n        </svg>\n      </div>\n    </div>\n\n    <!-- 6. Extrusion -->\n    <div class=\"bg-[var(--card)] text-[var(--foreground)] border border-[var(--border)] rounded-xl p-5 shadow-sm\">\n      <h2 class=\"font-semibold text-lg mb-2\">6. Extrusion (Forward vs Backward)</h2>\n      <p class=\"text-[var(--muted-foreground)] text-sm mb-4\">Notice the hollow ram in backward extrusion.</p>\n      <div class=\"flex justify-center gap-8 bg-white p-4 rounded-lg\">\n        <!-- Forward -->\n        <svg width=\"200\" height=\"200\" viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n          <text x=\"40\" y=\"20\" fill=\"#0f172a\" font-weight=\"bold\" font-family=\"sans-serif\">Forward Extrusion</text>\n          <!-- Chamber -->\n          <rect x=\"40\" y=\"80\" width=\"100\" height=\"10\" fill=\"#94a3b8\"/>\n          <rect x=\"40\" y=\"150\" width=\"100\" height=\"10\" fill=\"#94a3b8\"/>\n          <!-- Billet -->\n          <rect x=\"90\" y=\"90\" width=\"40\" height=\"60\" fill=\"#ef4444\"/>\n          <!-- Ram -->\n          <rect x=\"20\" y=\"90\" width=\"70\" height=\"60\" fill=\"#cbd5e1\" stroke=\"#000\"/>\n          <!-- Arrow Ram -->\n          <path d=\"M 50 120 L 70 120 M 65 115 L 70 120 L 65 125\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n          <!-- Die -->\n          <rect x=\"140\" y=\"80\" width=\"10\" height=\"20\" fill=\"#0f172a\"/>\n          <rect x=\"140\" y=\"140\" width=\"10\" height=\"20\" fill=\"#0f172a\"/>\n          <!-- Product -->\n          <rect x=\"150\" y=\"100\" width=\"40\" height=\"40\" fill=\"#ef4444\"/>\n          <!-- Product Arrow -->\n          <path d=\"M 160 120 L 180 120 M 175 115 L 180 120 L 175 125\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\"/>\n        </svg>\n        <!-- Backward -->\n        <svg width=\"200\" height=\"200\" viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n          <text x=\"30\" y=\"20\" fill=\"#0f172a\" font-weight=\"bold\" font-family=\"sans-serif\">Backward Extrusion</text>\n          <!-- Chamber -->\n          <path d=\"M 140 80 L 40 80 L 40 160 L 140 160\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"10\"/>\n          <!-- Billet -->\n          <rect x=\"50\" y=\"90\" width=\"60\" height=\"60\" fill=\"#ef4444\"/>\n          <!-- Hollow Ram with Die -->\n          <rect x=\"110\" y=\"90\" width=\"80\" height=\"20\" fill=\"#cbd5e1\" stroke=\"#000\"/>\n          <rect x=\"110\" y=\"130\" width=\"80\" height=\"20\" fill=\"#cbd5e1\" stroke=\"#000\"/>\n          <!-- Arrow Ram -->\n          <path d=\"M 160 100 L 140 100 M 145 95 L 140 100 L 145 105\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n          <!-- Product -->\n          <rect x=\"60\" y=\"110\" width=\"80\" height=\"20\" fill=\"#ef4444\"/>\n          <!-- Product Arrow -->\n          <path d=\"M 100 120 L 80 120 M 85 115 L 80 120 L 85 125\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\"/>\n        </svg>\n      </div>\n    </div>\n\n    <!-- 7. Wire vs Tube Drawing -->\n    <div class=\"bg-[var(--card)] text-[var(--foreground)] border border-[var(--border)] rounded-xl p-5 shadow-sm\">\n      <h2 class=\"font-semibold text-lg mb-2\">7. Wire vs Tube Drawing</h2>\n      <p class=\"text-[var(--muted-foreground)] text-sm mb-4\">For tube drawing, you MUST show the mandrel holding the inner diameter.</p>\n      <div class=\"flex justify-center gap-8 bg-white p-4 rounded-lg\">\n        <!-- Wire -->\n        <svg width=\"200\" height=\"150\" viewBox=\"0 0 200 150\" xmlns=\"http://www.w3.org/2000/svg\">\n          <text x=\"50\" y=\"20\" fill=\"#0f172a\" font-weight=\"bold\" font-family=\"sans-serif\">Wire Drawing</text>\n          <!-- Die -->\n          <path d=\"M 100 40 L 130 60 L 130 30 Z\" fill=\"#94a3b8\"/>\n          <path d=\"M 100 110 L 130 90 L 130 120 Z\" fill=\"#94a3b8\"/>\n          <!-- Wire -->\n          <path d=\"M 20 50 L 100 50 L 130 65 L 180 65\" fill=\"none\" stroke=\"#ef4444\" stroke-width=\"10\"/>\n        </svg>\n        <!-- Tube -->\n        <svg width=\"200\" height=\"150\" viewBox=\"0 0 200 150\" xmlns=\"http://www.w3.org/2000/svg\">\n          <text x=\"50\" y=\"20\" fill=\"#0f172a\" font-weight=\"bold\" font-family=\"sans-serif\">Tube Drawing</text>\n          <!-- Die -->\n          <path d=\"M 100 40 L 130 60 L 130 30 Z\" fill=\"#94a3b8\"/>\n          <path d=\"M 100 110 L 130 90 L 130 120 Z\" fill=\"#94a3b8\"/>\n          <!-- Tube -->\n          <path d=\"M 20 45 L 100 45 L 130 60 L 180 60 M 20 105 L 100 105 L 130 90 L 180 90\" fill=\"none\" stroke=\"#ef4444\" stroke-width=\"4\"/>\n          <!-- Mandrel -->\n          <rect x=\"100\" y=\"65\" width=\"20\" height=\"20\" rx=\"5\" fill=\"#0f172a\"/>\n          <line x1=\"20\" y1=\"75\" x2=\"100\" y2=\"75\" stroke=\"#0f172a\" stroke-width=\"3\"/>\n          <text x=\"110\" y=\"55\" fill=\"#000\" font-size=\"10\" font-family=\"sans-serif\">Mandrel</text>\n        </svg>\n      </div>\n    </div>\n\n  </div>\n</body>\n</html>","Description":"Created a visual reference guide with precise SVG diagrams for pattern allowances, pattern types, investment casting, gas flames, rolling derivation, extrusion, and tube drawing.","Overwrite":true,"TargetFile":"C:\\Users\\renu5\\.gemini\\antigravity\\brain\\cc5ae5f0-3c52-483a-b0d6-e323018f022c\\GTU_MidSem_Diagrams.html","toolAction":"Drawing SVGs","toolSummary":"Drawing diagram images"}}]}
