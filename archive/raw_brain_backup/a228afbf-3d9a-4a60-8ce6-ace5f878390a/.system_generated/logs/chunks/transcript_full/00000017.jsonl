n -c \"\nimport re\n\ninput_file = r'C:\\Users\\renu5\\Downloads\\college\\College sem 5\\ecm\\ECM_COMPLETE_StudyGuide.md'\noutput_file = r'C:\\Users\\renu5\\Downloads\\college\\College sem 5\\ecm\\ECM_QA_Only.md'\n\nwith open(input_file, 'r', encoding='utf-8') as f:\n    lines = f.readlines()\n\nqas = []\ncurrent_qa = None\n\nfor line in lines:\n    stripped_line = line.strip()\n    if stripped_line.startswith('**Q:') or stripped_line.startswith('**Question:**'):\n        if current_qa is not None:\n            qas.append(current_qa)\n        clean_q = stripped_line.replace('**', '')\n        bold_q = f'**{clean_q}**'\n        current_qa = {'question': bold_q, 'answer': []}\n    elif current_qa is not None:\n        if stripped_line.startswith('#') or stripped_line == '---':\n            continue\n        # Also let's ignore 'The following questions need hand-drawn diagrams...'\n        if stripped_line.startswith('The following questions need'):\n            continue\n        current_qa['answer'].append(line.rstrip())\n\nif current_qa is not None:\n    qas.append(current_qa)\n\nwith open(output_file, 'w', encoding='utf-8') as f:\n    for qa in qas:\n        f.write(qa['question'] + '\\n\\n')\n        answer_text = '\\n'.join(qa['answer']).strip()\n        if answer_text:\n            f.write(answer_text + '\\n\\n')\n        else:\n            f.write('\\n')\n\nprint(f'Extracted {len(qas)} questions with answers to {output_file}')\n\"","Cwd":"C:\\Users\\renu5\\.gemini\\antigravity\\scratch","WaitMsBeforeAsync":5000,"toolAction":"Extracting Q&A","toolSummary":"Extract questions with answers"}}]}
